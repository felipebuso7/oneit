{
  "name": "servicia-fsm",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/build-offline.mjs",
    "prebuild": "node scripts/generate-build-info.mjs && node scripts/build-offline.mjs",
    "dev": "next dev --webpack",
    "dev:local": "npm run dev -- --hostname 127.0.0.1 --port 3000",
    "dev:isolated": "node scripts/dev-isolated.mjs",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint",
    "lint:field-service": "eslint \"src/app/demo/field-service/**/*.tsx\" \"src/app/api/field-service/**/*.ts\" \"src/components/field-service/**/*.tsx\" \"src/lib/field-service/**/*.ts\" \"src/domain/reports/**/*.ts\"",
    "lint:core-ui": "eslint \"src/app/(portal)/layout.tsx\" \"src/app/(auth)/**/*.tsx\" \"src/components/**/*.tsx\"",
    "lint:finance": "eslint \"src/app/api/field-service/fiscal/**/*.ts\" \"src/app/api/field-service/measurement/**/*.ts\" \"src/app/api/internal/billing-email/**/*.ts\" \"src/app/demo/field-service/measurement/page.tsx\" \"src/app/demo/field-service/fiscal/page.tsx\" \"src/app/demo/field-service/fiscal/history/page.tsx\" \"src/app/demo/field-service/finance/page.tsx\"",
    "lint:stabilization": "eslint \"src/app/api/health/route.ts\" \"src/app/api/ready/route.ts\" \"src/lib/runtime/readiness.ts\" \"src/domain/reports/pdf.ts\" \"src/app/(portal)/portal/reports/actions.ts\" \"src/app/(portal)/portal/reports/page.tsx\" \"tests/health-route.test.ts\" \"tests/ready-route.test.ts\" \"tests/readiness.test.ts\" \"tests/report-pdf-images.test.ts\" \"tests/report-download-contract.test.ts\" \"tests/report-evidence-paths-migration.test.ts\"",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "verify": "npm run lint:stabilization && npm run lint:field-service && npm run lint:core-ui && npm run lint:finance && npm run typecheck && npm test && npm run build",
    "bootstrap:admin": "node scripts/bootstrap-initial-admin.mjs",
    "migrate:self-hosted": "node scripts/migrate-self-hosted.mjs",
    "audit:migrations": "node scripts/audit-migrations.mjs",
    "audit:migrations:strict": "node scripts/audit-migrations.mjs --strict",
    "audit:billing-db": "node scripts/audit-billing-db.mjs",
    "check:production-env": "node scripts/check-production-env.mjs",
    "check:release-tree": "node scripts/check-release-tree.mjs",
    "check:running-version": "node scripts/check-running-version.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.117.2",
    "@types/pg": "^8.23.1",
    "jose": "^6.2.12",
    "next": "16.3.7",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^3.2.7",
    "esbuild": "^0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.3.7",
    "fake-indexeddb": "^6.2.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
